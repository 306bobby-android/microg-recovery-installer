# microg-recovery-installer -- APK sources
#
# This file is the single source of truth for what goes into the flashable zip.
# It is read by scripts/fetch_apks.py (CI) and used to generate installer/apps.list.
#
# For every component:
#   <K>_NAME        Human readable name shown by the installer
#   <K>_PACKAGE     Android package name (used for verification/whitelists)
#   <K>_DEST        Name used on device: /system/<target>/<DEST>/<DEST>.apk
#   <K>_TARGET      priv-app | app
#   <K>_OPTIONAL    1 = the installer asks before installing it
#   <K>_EXTRACT_LIBS 1 = extract lib/<abi>/*.so next to the apk (needed for JNI apps)
#   <K>_CERT_SHA256 SHA-256 of the signing certificate (DER), no colons.
#                   Downloads that do not match are rejected. This is what the
#                   privapp-permissions / default-permissions XMLs pin to.
#   <K>_RESOLVER    fdroid | gitlab | github | direct
#   <K>_URL         Pinned fallback URL, used when resolution fails or
#                   RESOLVER=direct. Keep it up to date-ish; it is the safety net.
#
# Resolver specific:
#   fdroid: <K>_FDROID_REPO   base URL of an F-Droid repo (index-v1.jar / api v1)
#   gitlab: <K>_GITLAB_PROJECT  namespace/project, <K>_ASSET_REGEX  matches the
#           APK link inside the newest release description
#   github: <K>_GITHUB_REPO   owner/name,          <K>_ASSET_REGEX  matches an
#           asset filename of the newest release

COMPONENTS="GMS GSF FAKESTORE AURORA_STORE AURORA_SERVICES FDROID_PRIV"

# --- microG Services Core -----------------------------------------------------
GMS_NAME="microG Services"
GMS_PACKAGE="com.google.android.gms"
GMS_DEST="GmsCore"
GMS_TARGET="priv-app"
GMS_OPTIONAL=0
GMS_EXTRACT_LIBS=1
GMS_CERT_SHA256="9BD06727E62796C0130EB6DAB39B73157451582CBD138E86C468ACC395D14165"
GMS_RESOLVER="fdroid"
GMS_FDROID_REPO="https://repo.microg.org/fdroid/repo"
GMS_URL="https://repo.microg.org/fdroid/repo/com.google.android.gms-252432032.apk"

# --- microG Services Framework Proxy (GSF) ------------------------------------
GSF_NAME="microG Services Framework Proxy"
GSF_PACKAGE="com.google.android.gsf"
GSF_DEST="GoogleServicesFramework"
GSF_TARGET="priv-app"
GSF_OPTIONAL=0
GSF_EXTRACT_LIBS=0
GSF_CERT_SHA256="9BD06727E62796C0130EB6DAB39B73157451582CBD138E86C468ACC395D14165"
GSF_RESOLVER="fdroid"
GSF_FDROID_REPO="https://repo.microg.org/fdroid/repo"
GSF_URL="https://repo.microg.org/fdroid/repo/com.google.android.gsf-8.apk"

# --- microG Companion / FakeStore --------------------------------------------
FAKESTORE_NAME="microG Companion (FakeStore)"
FAKESTORE_PACKAGE="com.android.vending"
FAKESTORE_DEST="FakeStore"
FAKESTORE_TARGET="priv-app"
FAKESTORE_OPTIONAL=0
FAKESTORE_EXTRACT_LIBS=0
FAKESTORE_CERT_SHA256="9BD06727E62796C0130EB6DAB39B73157451582CBD138E86C468ACC395D14165"
FAKESTORE_RESOLVER="fdroid"
FAKESTORE_FDROID_REPO="https://repo.microg.org/fdroid/repo"
FAKESTORE_URL="https://repo.microg.org/fdroid/repo/com.android.vending-84022632.apk"

# --- Aurora Store -------------------------------------------------------------
# IzzyOnDroid redistributes the upstream (Rahul Patel signed) APK unchanged,
# which is the same signing key as Aurora Services. GitLab release uploads sit
# behind a Cloudflare challenge and are not usable from CI.
AURORA_STORE_NAME="Aurora Store"
AURORA_STORE_PACKAGE="com.aurora.store"
AURORA_STORE_DEST="AuroraStore"
AURORA_STORE_TARGET="app"
AURORA_STORE_OPTIONAL=0
AURORA_STORE_EXTRACT_LIBS=0
AURORA_STORE_CERT_SHA256="4C626157AD02BDA3401A7263555F68A79663FC3E13A4D4369A12570941AA280F"
AURORA_STORE_RESOLVER="fdroid"
AURORA_STORE_FDROID_REPO="https://apt.izzysoft.de/fdroid/repo"
AURORA_STORE_URL="https://apt.izzysoft.de/fdroid/repo/com.aurora.store_76.apk"

# --- Aurora Services (optional) ----------------------------------------------
# Upstream is dormant (last release 1.1.1, 2021) but still works as a privileged
# installer backend for Aurora Store.
AURORA_SERVICES_NAME="Aurora Services"
AURORA_SERVICES_PACKAGE="com.aurora.services"
AURORA_SERVICES_DEST="AuroraServices"
AURORA_SERVICES_TARGET="priv-app"
AURORA_SERVICES_OPTIONAL=1
AURORA_SERVICES_EXTRACT_LIBS=0
AURORA_SERVICES_CERT_SHA256="4C626157AD02BDA3401A7263555F68A79663FC3E13A4D4369A12570941AA280F"
AURORA_SERVICES_RESOLVER="gitlab"
AURORA_SERVICES_GITLAB_PROJECT="AuroraOSS/AuroraServices"
AURORA_SERVICES_ASSET_REGEX="^AuroraServices[-_]v?[0-9][0-9.]*\.apk$"
AURORA_SERVICES_URL="https://gitlab.com/AuroraOSS/AuroraServices/uploads/c22e95975571e9db143567690777a56e/AuroraServices_v1.1.1.apk"

# --- F-Droid Privileged Extension (optional) ---------------------------------
FDROID_PRIV_NAME="F-Droid Privileged Extension"
FDROID_PRIV_PACKAGE="org.fdroid.fdroid.privileged"
FDROID_PRIV_DEST="FDroidPrivilegedExtension"
FDROID_PRIV_TARGET="priv-app"
FDROID_PRIV_OPTIONAL=1
FDROID_PRIV_EXTRACT_LIBS=0
FDROID_PRIV_CERT_SHA256="43238D512C1E5EB2D6569F4A3AFBF5523418B82E0A3ED1552770ABB9A9C9CCAB"
FDROID_PRIV_RESOLVER="fdroid"
FDROID_PRIV_FDROID_REPO="https://f-droid.org/repo"
FDROID_PRIV_URL="https://f-droid.org/repo/org.fdroid.fdroid.privileged_2130.apk"
