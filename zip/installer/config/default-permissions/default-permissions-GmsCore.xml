<?xml version="1.0" encoding="utf-8"?>
<!--
    Runtime permissions pre-granted to microG Services so that it works right
    after the first boot. None of them are fixed, so the user can still revoke
    every single one from Settings.
-->
<exceptions>
    <exception package="com.google.android.gms" sha256-cert-digest="9B:D0:67:27:E6:27:96:C0:13:0E:B6:DA:B3:9B:73:15:74:51:58:2C:BD:13:8E:86:C4:68:AC:C3:95:D1:41:65">
        <!-- Accounts and contacts -->
        <permission name="android.permission.GET_ACCOUNTS" fixed="false" />
        <permission name="android.permission.READ_CONTACTS" fixed="false" />
        <permission name="android.permission.WRITE_CONTACTS" fixed="false" />
        <!-- Location -->
        <permission name="android.permission.ACCESS_COARSE_LOCATION" fixed="false" />
        <permission name="android.permission.ACCESS_FINE_LOCATION" fixed="false" />
        <permission name="android.permission.ACCESS_BACKGROUND_LOCATION" fixed="false" />
        <!-- Phone and messaging, used by device registration / SMS retriever -->
        <permission name="android.permission.READ_PHONE_STATE" fixed="false" />
        <permission name="android.permission.RECEIVE_SMS" fixed="false" whitelisted="true" />
        <!-- Storage -->
        <permission name="android.permission.READ_EXTERNAL_STORAGE" fixed="false" />
        <permission name="android.permission.WRITE_EXTERNAL_STORAGE" fixed="false" />
        <!-- Notifications (Android 13+) -->
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false" />
    </exception>
</exceptions>
